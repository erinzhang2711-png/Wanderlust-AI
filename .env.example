# Copy this file to .env and replace every blank value with your own credentials.
# Create the key in HKUST API Developer Portal: Products -> hkust-genai-v1 -> Subscribe.
HKUST_GENAI_API_KEY=
HKUST_GENAI_BASE_URL=https://hkust.azure-api.net/hkust-genai/v1/
HKUST_GENAI_CHAT_MODEL=gpt-4o-mini
HKUST_GENAI_EMBEDDING_MODEL=text-embedding-3-small

PINECONE_API_KEY=
PINECONE_INDEX_NAME=wanderlust-cities
PINECONE_NAMESPACE=cities-v1
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_DIMENSION=1536

RAPIDAPI_KEY=
# Subscribe to the free plans for Tripadvisor COM, Hotels.com Provider, and World Weather Online.
# For place-specific attraction and restaurant photos, also subscribe to Travel Advisor.
RAPIDAPI_TRIPADVISOR_HOST=tripadvisor-com1.p.rapidapi.com
RAPIDAPI_TRAVEL_ADVISOR_HOST=
RAPIDAPI_HOTELS_HOST=hotels-com-provider.p.rapidapi.com
RAPIDAPI_WEATHER_HOST=world-weather-online-api1.p.rapidapi.com
WANDERLUST_DEMO_MODE=false
